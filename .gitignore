############################################################
# 🧠  Core ignores — macOS + OS-level
############################################################

# macOS metadata
.DS_Store
.AppleDouble
.LSOverride
.Icon
._*
.Spotlight-V100
.Trashes
**/.Trash-*
.DS_Store?
ehthumbs.db
Thumbs.db

############################################################
# 🧑‍💻  IDEs & editors
############################################################

# VS Code
.vscode/*
!.vscode/settings.json      # Keep project settings if relevant
!.vscode/extensions.json    # Keep recommended extensions list
!.vscode/tasks.json
!.vscode/launch.json

# JetBrains (WebStorm, PhpStorm, etc.)
.idea/
*.iml

# Sublime Text
*.sublime-workspace
*.sublime-project

############################################################
# 🧱  Dependency managers / build systems
############################################################

# Node.js / npm / yarn / pnpm
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Parcel / Vite / Next / React / Vue build output
dist/
build/
out/
.next/
.nuxt/
.cache/
.eslintcache
coverage/
.tmp/
temp/

# Sass / PostCSS intermediates
.sass-cache/
*.css.map
*.scssc

# TypeScript
*.tsbuildinfo

############################################################
# 🗂  Environment & config files (keep sensitive stuff out)
############################################################

# Local environment config
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Credentials or API keys
*.pem
*.key
*.crt
*.cert
*.p12

############################################################
# 📸  Miscellaneous generated data
############################################################

# Logs
logs/
*.log
*.log.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Temporary editors / OS backups
*~
*.swp
*.tmp
*.bak
*.orig

# Archive artifacts
*.zip
*.tar.gz
*.tgz

# Project exports
export/
backups/

############################################################
# 🧩  Project-specific (symlinks, docs, etc.)
############################################################
# Keep documentation and proper symlinks tracked
!documentation/
!/LICENSE.txt
!/README.md

############################################################
# Jekyll build output
############################################################
# _site/ is generated. The deploy builds it in GitHub Actions
# (Pagefind indexes the built tree post-build), so a committed
# copy is a duplicate of every change and makes diffs unreadable.
_site/
.jekyll-cache/
.jekyll-metadata
